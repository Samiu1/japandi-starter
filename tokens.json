{
  "$description": "japandi-starter design tokens. SINGLE SOURCE OF TRUTH - edit values here, then run `python3 tools/build-tokens.py` to regenerate tokens.css, tailwind.preset.js, and the example page's token block. Never edit the generated files by hand.",
  "$format": "dtcg-flavored: each token has $type / $value / $description; {category.name} is an alias reference. Deliberately not full DTCG spec - no $extensions, no modes - until a consumer (Figma Tokens Studio, Style Dictionary) needs it.",
  "color": {
    "$sections": [
      {
        "title": "Color: neutrals (warm, never pure)",
        "tokens": [
          "paper",
          "surface",
          "sand",
          "clay",
          "stone"
        ]
      },
      {
        "title": "Color: ink (soft warm black, never #000)",
        "tokens": [
          "ink",
          "ink-soft"
        ]
      },
      {
        "title": "Color: accents (muted, one per view)",
        "tokens": [
          "sage",
          "sage-deep",
          "rust",
          "rust-deep"
        ]
      },
      {
        "title": "Color: borders",
        "tokens": [
          "border",
          "border-strong"
        ]
      }
    ],
    "border": {
      "$description": "default hairline border - decorative dividers only (1.3:1 on paper)",
      "$type": "color",
      "$value": "#E2DACB"
    },
    "border-strong": {
      "$description": "functional borders that convey a boundary, e.g. inputs (3.5:1 on paper, WCAG non-text)",
      "$type": "color",
      "$value": "#878177"
    },
    "clay": {
      "$description": "deeper neutral, quiet emphasis",
      "$type": "color",
      "$value": "#D3C6B0"
    },
    "ink": {
      "$description": "primary text",
      "$type": "color",
      "$value": "#2C2823"
    },
    "ink-soft": {
      "$description": "secondary text, captions",
      "$type": "color",
      "$value": "#6B6357"
    },
    "paper": {
      "$description": "page background - warm white, not #FFF",
      "$type": "color",
      "$value": "#F6F3EC"
    },
    "rust": {
      "$description": "warm accent - muted terracotta, use sparingly.\nDecorative use only with text (3.3:1).",
      "$type": "color",
      "$value": "#B0795B"
    },
    "rust-deep": {
      "$description": "text-bearing rust: fills behind paper text\n(5.2:1, WCAG AA)",
      "$type": "color",
      "$value": "#8A5A3E"
    },
    "sage": {
      "$description": "primary accent - desaturated green.\nDecorative use only with text (3.5:1).",
      "$type": "color",
      "$value": "#7C8471"
    },
    "sage-deep": {
      "$description": "text-bearing sage: fills behind paper text,\ne.g. primary buttons (5.2:1, WCAG AA)",
      "$type": "color",
      "$value": "#62685A"
    },
    "sand": {
      "$description": "subtle fills, hairline borders",
      "$type": "color",
      "$value": "#E9E2D3"
    },
    "stone": {
      "$description": "muted mid-tone for large washes and dark-mode\npairings - never light text on it (2.4:1)",
      "$type": "color",
      "$value": "#A79C89"
    },
    "surface": {
      "$description": "raised surfaces: cards, panels",
      "$type": "color",
      "$value": "#FBF9F4"
    }
  },
  "focus": {
    "$sections": [
      {
        "title": "Focus (visible indicator, 3:1 minimum against adjacent colors)",
        "tokens": [
          "focus-width",
          "focus-offset",
          "focus-color"
        ]
      }
    ],
    "focus-color": {
      "$description": "alias of ink - 13.2:1 on paper, 13.9:1 on surface",
      "$type": "color",
      "$value": "{color.ink}"
    },
    "focus-offset": {
      "$description": "gap between component and ring",
      "$type": "dimension",
      "$value": "2px"
    },
    "focus-width": {
      "$description": "focus ring thickness",
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "motion": {
    "$sections": [
      {
        "title": "Motion (quiet, never bouncy)",
        "tokens": [
          "duration-fast",
          "duration-base",
          "duration-slow",
          "ease-out",
          "ease-in-out"
        ]
      }
    ],
    "duration-base": {
      "$description": "standard transitions",
      "$type": "duration",
      "$value": "250ms"
    },
    "duration-fast": {
      "$description": "micro-interactions: hovers, toggles",
      "$type": "duration",
      "$value": "150ms"
    },
    "duration-slow": {
      "$description": "deliberate movement: panels, overlays",
      "$type": "duration",
      "$value": "400ms"
    },
    "ease-in-out": {
      "$description": "exits and state changes",
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "ease-out": {
      "$description": "entrances - settles softly",
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.25, 1, 0.5, 1)"
    }
  },
  "radius": {
    "$sections": [
      {
        "title": "Radii (subtle rounding, nothing bubbly)",
        "tokens": [
          "radius-sm",
          "radius-md",
          "radius-lg",
          "radius-full"
        ]
      }
    ],
    "radius-full": {
      "$description": "",
      "$type": "dimension",
      "$value": "9999px"
    },
    "radius-lg": {
      "$description": "",
      "$type": "dimension",
      "$value": "16px"
    },
    "radius-md": {
      "$description": "",
      "$type": "dimension",
      "$value": "8px"
    },
    "radius-sm": {
      "$description": "",
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "shadow": {
    "$sections": [
      {
        "title": "Shadows (soft, warm-tinted, low opacity)",
        "tokens": [
          "shadow-sm",
          "shadow-md",
          "shadow-lg"
        ]
      }
    ],
    "shadow-lg": {
      "$description": "",
      "$type": "shadow",
      "$value": "0 12px 32px rgba(44, 40, 35, 0.08)"
    },
    "shadow-md": {
      "$description": "",
      "$type": "shadow",
      "$value": "0 4px 12px rgba(44, 40, 35, 0.06)"
    },
    "shadow-sm": {
      "$description": "",
      "$type": "shadow",
      "$value": "0 1px 2px rgba(44, 40, 35, 0.05)"
    }
  },
  "space": {
    "$sections": [
      {
        "title": "Spacing (4px base)",
        "tokens": [
          "space-1",
          "space-2",
          "space-3",
          "space-4",
          "space-6",
          "space-8",
          "space-12",
          "space-16",
          "space-24"
        ]
      }
    ],
    "space-1": {
      "$description": "",
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "space-12": {
      "$description": "",
      "$type": "dimension",
      "$value": "3rem"
    },
    "space-16": {
      "$description": "",
      "$type": "dimension",
      "$value": "4rem"
    },
    "space-2": {
      "$description": "",
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "space-24": {
      "$description": "",
      "$type": "dimension",
      "$value": "6rem"
    },
    "space-3": {
      "$description": "",
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "space-4": {
      "$description": "",
      "$type": "dimension",
      "$value": "1rem"
    },
    "space-6": {
      "$description": "",
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "space-8": {
      "$description": "",
      "$type": "dimension",
      "$value": "2rem"
    }
  },
  "type": {
    "$sections": [
      {
        "title": "Typography",
        "tokens": [
          "font-sans",
          "font-serif",
          "text-xs",
          "text-sm",
          "text-base",
          "text-lg",
          "text-xl",
          "text-2xl",
          "text-3xl",
          "leading-body",
          "leading-heading",
          "tracking-heading"
        ]
      }
    ],
    "font-sans": {
      "$description": "UI and body",
      "$type": "fontFamily",
      "$value": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "font-serif": {
      "$description": "display headings only",
      "$type": "fontFamily",
      "$value": "\"Fraunces\", \"Newsreader\", Georgia, serif"
    },
    "leading-body": {
      "$description": "body line-height",
      "$type": "number",
      "$value": "1.6"
    },
    "leading-heading": {
      "$description": "heading line-height",
      "$type": "number",
      "$value": "1.2"
    },
    "text-2xl": {
      "$description": "31.3px",
      "$type": "dimension",
      "$value": "1.953rem"
    },
    "text-3xl": {
      "$description": "39.1px",
      "$type": "dimension",
      "$value": "2.441rem"
    },
    "text-base": {
      "$description": "16px",
      "$type": "dimension",
      "$value": "1rem"
    },
    "text-lg": {
      "$description": "20px",
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "text-sm": {
      "$description": "14.2px",
      "$type": "dimension",
      "$value": "0.889rem"
    },
    "text-xl": {
      "$description": "25px",
      "$type": "dimension",
      "$value": "1.563rem"
    },
    "text-xs": {
      "$description": "12.8px",
      "$type": "dimension",
      "$value": "0.8rem"
    },
    "tracking-heading": {
      "$description": "heading letter-spacing",
      "$type": "dimension",
      "$value": "-0.01em"
    }
  },
  "z": {
    "$sections": [
      {
        "title": "Z-index (flat layouts first - reach for these only when layering)",
        "tokens": [
          "z-sticky",
          "z-overlay",
          "z-modal",
          "z-toast"
        ]
      }
    ],
    "z-modal": {
      "$description": "dialogs, drawers",
      "$type": "number",
      "$value": "300"
    },
    "z-overlay": {
      "$description": "dimming overlays",
      "$type": "number",
      "$value": "200"
    },
    "z-sticky": {
      "$description": "sticky headers",
      "$type": "number",
      "$value": "100"
    },
    "z-toast": {
      "$description": "toasts, always on top",
      "$type": "number",
      "$value": "400"
    }
  }
}
